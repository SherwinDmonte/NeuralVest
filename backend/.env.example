# NeuralVest backend configuration TEMPLATE.
# Copy to `backend/.env` and fill in real values there. NEVER commit `.env`.
# Every value below is a placeholder.

# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ----- MongoDB Atlas (Phase 2) -----
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=neuralvest_db
MONGODB_TEST_DB_NAME=neuralvest_db_test
STORAGE_WARN_PCT=60
STORAGE_BLOCK_PCT=85
# MB used by OTHER projects on the same Atlas cluster (shared free tier). NeuralVest's
# database user cannot measure them, so enter the size shown in the Atlas UI.
STORAGE_RESERVED_MB=0
MARKET_DATA_MAX_YEARS=5

# ----- Ollama / LLM (Phase 4) -----
OLLAMA_BASE_URL=http://localhost:11434
# Adaptive setup (decision after Phase 4, tasks.md): the 1.7B model is used when at least
# LLM_MIN_FREE_RAM_MB of RAM is free, otherwise the lighter 0.6B model. Each result records
# which model answered. An empty fallback means: use the deterministic text template.
LLM_PRIMARY_MODEL=qwen3:1.7b
LLM_FALLBACK_MODEL=qwen3:0.6b
LLM_NUM_CTX=2048
LLM_TIMEOUT_SECONDS=90
LLM_MIN_FREE_RAM_MB=1800
MAX_NEWS_ARTICLES_LLM=8

# ----- Analysis -----
AGENT_EXECUTION_MODE=sequential
# Risk-free rate (Phase 8): enter manually; value, date and source are all required.
RISK_FREE_RATE_PCT=<value>
RISK_FREE_RATE_DATE=<YYYY-MM-DD>
RISK_FREE_RATE_SOURCE=<description>

# ----- Auth (Phase 11) -----
JWT_SECRET=<generate-locally>
JWT_EXPIRE_MINUTES=60
